# Merged on top of x86_64_defconfig.
CONFIG_LOCALVERSION="-valence"
CONFIG_DEFAULT_HOSTNAME="valence"
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_E1000=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
# No modules: everything we need is built in.
# CONFIG_MODULES is not set
